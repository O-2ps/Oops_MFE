{
  "expo": {
    "name": "Oops!",
    "slug": "Oops_MFE",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oops.beauty",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.oops.beauty",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "피부 분석을 위해 카메라 접근이 필요합니다."
        }
      ],
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "40df0a445004e2606fd3229d6b656b6a",
          "kotlinVersion": "2.0.21"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "13639715-2425-43b8-8cff-5200c23ae62a"
      }
    }
  }
}
